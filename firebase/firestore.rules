rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    match /favorites/{document} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
    }

    match /watchlist/{document} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth.uid == resource.data.userId;
      allow write: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
    }

    match /reviews/{document} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow write: if request.auth.uid == resource.data.userId;
      allow delete: if request.auth.uid == resource.data.userId;
    }

    match /follows/{document} {
      allow create: if request.auth.uid == request.resource.data.followerId;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth.uid == resource.data.followerId;
    }

    match /reviewLikes/{document} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null;
    }

    match /rooms/{document} {
      allow create: if request.auth.uid == request.resource.data.hostId;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }

    match /roomSwipes/{document} {
      allow create: if request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }
  }
}
